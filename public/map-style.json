{
  "version": 8,
  "name": "Nashville Cleaning Directory",
  "metadata": {
    "mapbox:autocomposite": true,
    "mapbox:type": "template",
    "openmaptiles:version": "3.3",
    "openmaptiles:attribution": "<a href=\"https://www.maptiler.com\" target=\"_blank\">&copy; MapTiler</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openmapt.org/data/openmaptiles.json"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f5f5"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#d0e8f2"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "park",
          "#dff7c4",
          "grass",
          "#eef7e1",
          "forest",
          "#d4f1e3",
          "#f0f0f0"
        ],
        "fill-opacity": 0.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#e6e6e6",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "line-color": "#d0d0d0",
        "line-width": 0.5
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        "path",
        "footway",
        "cycleway",
        "steps"
      ],
      "paint": {
        "line-color": "#cccccc",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.5,
          20,
          2
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        "minor",
        "service",
        "track"
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          1,
          20,
          4
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        "secondary",
        "tertiary"
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          2,
          20,
          6
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        "primary"
      ],
      "paint": {
        "line-color": "#ffd966",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          3,
          20,
          8
        ]
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        "trunk",
        "motorway"
      ],
      "paint": {
        "line-color": "#ff8a65",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          4,
          20,
          10
        ]
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "get",
          "name_en"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-anchor": "top",
        "text-offset": [
          0,
          1
        ],
        "icon-image": [
          "get",
          "class"
        ],
        "icon-size": 1
      },
      "paint": {
        "text-color": "#3d3f47",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": [
          "get",
          "name_en"
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          20,
          10,
          24
        ]
      },
      "paint": {
        "text-color": "#3d3f47",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
